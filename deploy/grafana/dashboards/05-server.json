{
 "uid": "servmon-server",
 "title": "Servers · Server detail",
 "description": "Hardware-level metrics per server",
 "tags": [
  "servmon"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "15s",
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "15s",
   "30s",
   "1m",
   "5m",
   "15m",
   "1h"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "servmon-prom"
    },
    "query": {
     "query": "label_values(servmon_up, host)",
     "refId": "v",
     "qryType": 1
    },
    "definition": "label_values(servmon_up, host)",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "servmon"
   ],
   "asDropdown": false,
   "includeVars": true,
   "keepTime": true,
   "title": "servmon"
  }
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "servmon-prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * servmon_host_cpu_busy_ratio{host=~\"$host\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "{{host}} busy"
    },
    {
     "refId": "B",
     "expr": "100 * servmon_host_cpu_iowait_ratio{host=~\"$host\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "{{host}} iowait"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 60000,
      "gradientMode": "none",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisSoftMin": 0,
      "insertNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ],
     "showLegend": true,
     "sortBy": "Mean",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
