  {
   "type": "table",
   "title": "Servers",
   "description": "Current state of each server. idle-held = memory held by jobs that have been idle longer than the collector's idle_after setting.",
   "datasource": {
    "type": "prometheus",
    "uid": "servmon-prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum without() (servmon_up{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "100 * servmon_host_cpu_busy_ratio{host=~\"$host\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "sum without() (servmon_host_load1{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "sum without() (servmon_host_ncpu{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "E",
     "expr": "100 * servmon_host_mem_used_bytes{host=~\"$host\"} / servmon_host_mem_total_bytes",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "F",
     "expr": "sum without() (servmon_host_mem_total_bytes{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "G",
     "expr": "avg by(host) (servmon_gpu_util_percent{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "H",
     "expr": "100 * sum by(host) (servmon_gpu_mem_used_bytes{host=~\"$host\"}) / sum by(host) (servmon_gpu_mem_total_bytes)",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "I",
     "expr": "count by(host) (servmon_gpu_util_percent{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "J",
     "expr": "count by(host) (servmon_user_cpu_cores{host=~\"$host\"} > 0.1 or sum by(host,user) (servmon_user_gpu_mem_bytes{host=~\"$host\"}) > 0)",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "K",
     "expr": "count by(host) (servmon_user_sessions{host=~\"$host\"} > 0)",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "L",
     "expr": "sum by(host) (servmon_user_idle_gpu_mem_bytes{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "M",
     "expr": "sum by(host) (servmon_user_idle_mem_bytes{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "N",
     "expr": "sum by(host) (servmon_gpu_available{host=~\"$host\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "servmon-prom"
     },
     "legendFormat": "__auto",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
