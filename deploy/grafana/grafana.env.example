# Copy to deploy/grafana/grafana.env (git-ignored) to override grafana.ini for your
# deployment, then re-run scripts/podman-install.sh (or restart Grafana).
# Every grafana.ini key can be set as GF_<SECTION>_<KEY>; see docs/remote-access.md
# for when to use which of these.

# --- Reached under a real URL (needed for correct links and redirects) -------------
# GF_SERVER_ROOT_URL=https://servers.example.org/

# --- A: logins only — turn off anonymous access ------------------------------------
# GF_AUTH_ANONYMOUS_ENABLED=false
# GF_USERS_ALLOW_SIGN_UP=false
# GF_SECURITY_COOKIE_SECURE=true          # when served over HTTPS

# --- B: Grafana's own single sign-on (Google, GitHub, GitLab, any OIDC provider) ---
# GF_AUTH_ANONYMOUS_ENABLED=false
# GF_AUTH_GOOGLE_ENABLED=true
# GF_AUTH_GOOGLE_CLIENT_ID=...
# GF_AUTH_GOOGLE_CLIENT_SECRET=...
# GF_AUTH_GOOGLE_ALLOWED_DOMAINS=example.edu
# GF_AUTH_GOOGLE_AUTO_LOGIN=true

# --- C: trust an identity-aware proxy that sends a signed JWT ----------------------
# (only safe if Grafana is reachable *only* through that proxy)
# The token must contain a `sub` claim and the key-set URL must be https; Grafana silently
# ignores tokens without `sub`.
# GF_AUTH_ANONYMOUS_ENABLED=false
# GF_AUTH_JWT_ENABLED=true
# GF_AUTH_JWT_HEADER_NAME=<header the proxy sets>
# GF_AUTH_JWT_JWK_SET_URL=<proxy's public keys URL>
# GF_AUTH_JWT_EXPECT_CLAIMS={"iss": "<issuer>", "aud": ["<audience>"]}
# GF_AUTH_JWT_EMAIL_CLAIM=email
# GF_AUTH_JWT_USERNAME_CLAIM=email
# GF_AUTH_JWT_AUTO_SIGN_UP=true
# GF_AUTH_JWT_ROLE_ATTRIBUTE_PATH=email == 'you@example.edu' && 'Admin' || 'Viewer'
