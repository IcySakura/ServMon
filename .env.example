# Copy to .env (scripts/setup.sh does this and fills in your uid/gid). .env is git-ignored.
# After changing it: scripts/podman-install.sh  (Docker: docker compose up -d)

# Containers run as this uid/gid, so data/ stays owned by you and ssh accepts SSH_DIR.
SERVMON_UID=1000
SERVMON_GID=1000

# Directory holding the SSH keys + ~/.ssh/config Host aliases used in config.toml.
# Mounted read-only into the collector. Use a dedicated directory if you prefer.
SSH_DIR=~/.ssh

# Where Prometheus, Grafana and the raw archive keep their data.
SERVMON_DATA=./data

# Host ports. Prometheus and the collector are always bound to 127.0.0.1.
GRAFANA_PORT=3300
PROMETHEUS_PORT=9390
COLLECTOR_PORT=9877
# Address Grafana is published on. Keep 127.0.0.1 unless you have read docs/remote-access.md.
BIND_ADDR=127.0.0.1

# Prometheus retention: whichever limit is hit first.
RETENTION_TIME=2y
RETENTION_SIZE=40GB

# Initial Grafana admin password (only applied when data/grafana is first created).
GRAFANA_ADMIN_PASSWORD=admin

# Optional (Podman install only): a Cloudflare Tunnel connector token. If set, a
# cloudflared container joins the pod; point the tunnel at http://localhost:3300.
# TUNNEL_TOKEN=
